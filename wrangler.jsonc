{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "app-nova",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "1d0cece9-557e-4c27-8fb9-846d30761616","database_name": "app-nova" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "3cbcaaf991fe4d5783aecff133002bb0" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
